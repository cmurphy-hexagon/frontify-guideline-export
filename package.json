{
  "name": "frontify-guideline-export",
  "private": true,
  "version": "0.1.0",
  "description": "Frontify export scripts",
  "scripts": {
    "export": "node export-guideline.js",
    "export:probe": "node export-guideline.js --probe",
    "export:dry-run": "node export-guideline.js --probe --dry-run",
    "export:flat": "node export-guideline.js --structure flat --output-mode split",
    "export:flat:both": "node export-guideline.js --structure flat --output-mode both",
    "export:docs": "node export-guideline.js --structure by-document --output-mode split",
    "export:docs:combined": "node export-guideline.js --structure by-document --output-mode combined",
    "export:docs:both": "node export-guideline.js --structure by-document --output-mode both"
  }
}
